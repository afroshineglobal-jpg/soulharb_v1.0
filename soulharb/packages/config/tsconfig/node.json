{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "SoulHarb Node service (apps/api, apps/worker)",
  "extends": "./base.json",
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": ["node"],
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "sourceMap": true,
    "declaration": false,
    "incremental": true
  }
}
