{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "SoulHarb library (packages/*, type-check only; tsup emits the build)",
  "extends": "./base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "verbatimModuleSyntax": true,
    "declaration": true,
    "noEmit": true
  }
}
