infra/cloudflared/cert.pem
*.pem
*.key
*.age
age-keys.txt

# Supabase local state
supabase/.temp/
supabase/.branches/

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# Editors and operating systems
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
